@model BTCPayServer.Plugins.Shopify.Models.ShopifySettings
@{
    Layout = "_Layout";
    ViewData.SetLayoutModel(new LayoutModel("shopify", StringLocalizer["Shopify"]).SetCategory(WellKnownCategories.Store));
    var shopifyCredsSet = Model?.IntegratedAt.HasValue is true;
    var shopifyUrl = Model?.ShopifyUrl;
}

<div class="relative p-3 border rounded [&>:last-child]:mb-0 text-[var(--btcpay-warning-text)] bg-[var(--btcpay-warning)] border-[var(--btcpay-warning-border)] pr-12 mb-6" role="alert">
	<button type="button" class="btn-close absolute top-0 right-0 z-2 p-[0.9375rem_1rem]" onclick="this.parentElement.remove()" aria-label="@StringLocalizer["Close"]">
		<vc:icon symbol="close" />
	</button>
	<h5 text-translate="true">Important notice</h5>
	<p class="my-2 mb-12">This Shopify integration has been discontinued by Shopify and will no longer be supported after <strong>August 31, 2025</strong>. If you completed your BTCPay Server-Shopify setup before <strong>December 31, 2024</strong>, you may continue using it until August 31, 2025. However, we recommend transitioning to Shopify V2 for continued functionality. All new users have to use Shopify V2. <a href="https://docs.btcpayserver.org/ShopifyV2/" rel="noreferrer noopener" class="font-normal" text-translate="true">Refer to this guide to get started with Shopify V2</a></p>
</div>


<div class="sticky-header">
    <h2 class="my-1">
        @ViewData["Title"]
        <small>
            <a href="https://docs.btcpayserver.org/Shopify" target="_blank" rel="noreferrer noopener" title="@StringLocalizer["More information..."]">
                <vc:icon symbol="info" />
            </a>
        </small>
    </h2>
</div>

<partial name="_StatusMessage" />

<div class="flex flex-wrap gap-6">
    <div class="content-constrain-xxl xl:w-2/3">
        <p text-translate="true">Connect BTCPay Server to your Shopify checkout experience to accept Bitcoin.</p>

        @if (!ViewContext.ModelState.IsValid)
        {
            <div asp-validation-summary="All"></div>
        }

        <form method="post" id="shopifyForm">
            <div class="form-group">
                <label asp-for="ShopName" class="form-label"></label>
                <div class="input-group">
                    @if (!Model?.ShopName?.Contains(".") is true)
                    {
                        <span class="input-group-text">https://</span>
                    }
                    <input asp-for="ShopName" class="form-control" readonly="@shopifyCredsSet"/>

                    @if (!shopifyCredsSet || !Model?.ShopName?.Contains(".") is true)
                    {
                        <span class="input-group-text">.myshopify.com</span>
                    }
                </div>
                <span asp-validation-for="ShopName" class="text-btcpay-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ApiKey" class="form-label"></label>
                <input asp-for="ApiKey" class="form-control" readonly="@shopifyCredsSet"/>
                <span asp-validation-for="ApiKey" class="text-btcpay-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" type="password" value="@Model?.Password" readonly="@shopifyCredsSet"/>
                <span asp-validation-for="Password" class="text-btcpay-danger"></span>
            </div>

            @if (shopifyCredsSet)
            {
                <div class="relative p-3 mb-4 border rounded [&>:last-child]:mb-0 text-[var(--btcpay-warning-text)] bg-[var(--btcpay-warning)] border-[var(--btcpay-warning-border)]">
                    <h5 text-translate="true">In Shopify, please do the following …</h5>
                    <ul>
                        <li>
                            Add a payment method at <a href="@shopifyUrl/admin/settings/payments" class="font-bold" target="_blank" rel="noreferrer noopener">Settings &gt; Payments &gt; Manual Payment Methods</a> with the name <strong>Bitcoin with BTCPay Server</strong>
                        </li>
                        <li>
                            Paste this script at <a href="@shopifyUrl/admin/settings/checkout#PolarisTextField1" class="font-bold" target="_blank" rel="noreferrer noopener">Settings &gt; Checkout &gt; Order Processing &gt; Additional Scripts</a>:
                            <pre class="mt-2 mb-0 text-wrap">@($"<script src='{Url.Action("ShopifyJavascript", "UIShopify", new { storeId = Context.GetRouteValue("storeId") }, Context.Request.Scheme)}'></script>")</pre>
                        </li>
                    </ul>
                </div>
                <p class="relative p-3 mb-4 border rounded [&>:last-child]:mb-0 text-[var(--btcpay-success-text)] bg-[var(--btcpay-success)] border-[var(--btcpay-success-border)]">
                    Orders on <b>@Model.ShopName</b>.myshopify.com will be marked as paid on successful invoice payment.
                    Started: @Model.IntegratedAt.Value.ToBrowserDate()
                </p>

                <button name="command" type="submit" class="btn btn-danger mt-4" value="ShopifyClearCredentials" text-translate="true">
                    Stop Shopify calls and clear credentials
                </button>
            }
            else
            {
                <button name="command" type="submit" class="btn btn-primary mt-4" value="ShopifySaveCredentials" text-translate="true">
                    Save
                </button>
            }
        </form>
    </div>
</div>
