@using BTCPayServer.Blazor.VaultBridge
@using BTCPayServer.Plugins.PullPayments.Boltcards
@model BTCPayServer.Plugins.PullPayments.Boltcards.SetupBoltcardViewModel
@{
    Layout = "_LayoutWizard";
    this.ViewData.SetBlazorAllowed(true);
}

@section Navbar {
	<a href="@Url.EnsureLocal(Model.ReturnUrl, Context.Request)" id="CancelWizard" class="cancel">
        <vc:icon symbol="cross" />
    </a>
}

<header class="text-center">
    @if (Model.NewCard)
    {
        <h1 text-translate="true">Setup Boltcard</h1>
    }
    else
    {
        <h1 text-translate="true">Reset Boltcard</h1>
    }

    <p class="page-subtitle" text-translate="true">Using BTCPay Server Vault (NFC)</p>
</header>

<div class="flex flex-wrap gap-6 mt-12 mb-6">
    <div class="md:w-2/3 mx-auto">
        <component type="typeof(VaultBridgeUI)"
                   param-Controller="@(new BoltcardVaultController()
                                     {
                                         NewCard = Model.NewCard,
                                         BoltcardUrl = Model.BoltcardUrl,
                                         PullPaymentId = Model.PullPaymentId
                                     })"
                   render-mode="Server"/>
    </div>
</div>

<div id="body" class="my-6">
	<form id="broadcastForm" method="post" style="display:none;">
    </form>
</div>


@section PageFootContent
{
    <script src="~/js/vaultbridge.js" asp-append-version="true"></script>
    <script>
        vault.done = function ()
        {
            $("#broadcastForm").submit();
        }
    </script>
}
