@{
    Layout = "_LayoutSimple";
    var allErrors = ViewData.ModelState.Values.SelectMany(v => v.Errors.Select(b => b.ErrorMessage));
}

<div class="flex flex-wrap gap-6">
    <div class="lg:w-full">
        <h2 text-translate="true">Pay Button request failed</h2>
        @foreach (var error in allErrors)
        {
            <div class="relative p-3 mb-4 border rounded [&>:last-child]:mb-0 text-[var(--btcpay-danger-text)] bg-[var(--btcpay-danger)] border-[var(--btcpay-danger-border)] mt-6">@error</div>
        }
    </div>
</div>
