@using System.Globalization
@using BTCPayServer.Abstractions.Contracts
@using BTCPayServer.Client
@using BTCPayServer.Forms
@using BTCPayServer.Plugins.Crowdfund
@inject FormDataService FormDataService
@inject IFileService FileService
@inject BTCPayServer.Security.ContentSecurityPolicies Csp
@model BTCPayServer.Plugins.Crowdfund.Models.UpdateCrowdfundViewModel
@{
    Layout = "_Layout";
    ViewData.SetLayoutModel(new LayoutModel($"{nameof(CrowdfundPlugin)}-{Model.AppId}", StringLocalizer["Update Crowdfund"]));
	Csp.UnsafeEval();
    var canUpload = await FileService.IsAvailable();
    var checkoutFormOptions = await FormDataService.GetSelect(Model.StoreId, Model.FormId);
}

@section PageHeadContent {
    <link href="~/vendor/summernote/summernote-bs5.css" rel="stylesheet" asp-append-version="true" />
}

@section PageFootContent {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/summernote-bridge.js" asp-append-version="true"></script>
    <script src="~/vendor/summernote/summernote-bs5.js" asp-append-version="true"></script>
    <script src="~/crowdfund/admin.js" asp-append-version="true"></script>
}

<form method="post" enctype="multipart/form-data" permissioned="@Policies.CanModifyStoreSettings">
    <div class="sticky-header">
        <h2>@ViewData["Title"]</h2>
        <div>
            <button id="page-primary" type="submit" class="btn btn-primary order-sm-1" text-translate="true">Save</button>
            <a class="btn btn-secondary" asp-action="ListInvoices" asp-controller="UIInvoice" asp-route-storeId="@Model.StoreId" asp-route-searchterm="@Model.SearchTerm" text-translate="true">Invoices</a>
			@if (Model.Archived)
            {
                <button type="submit" class="btn btn-outline-secondary" name="Archived" value="False" text-translate="true">Unarchive</button>
            }
            else if (Model.ModelWithMinimumData)
            {
                <a class="btn btn-secondary" asp-area="@CrowdfundPlugin.Area" asp-controller="UICrowdfund" asp-action="ViewCrowdfund" asp-route-appId="@Model.AppId" id="ViewApp" target="_blank" text-translate="true">View</a>
            }
        </div>
    </div>

    <partial name="_StatusMessage" />

    <input type="hidden" asp-for="StoreId" />
    <input type="hidden" asp-for="Archived" />

    @if (!ViewContext.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="@(ViewContext.ModelState.ErrorCount.Equals(1) ? "no-marker" : "")"></div>
    }
    <div class="flex flex-wrap gap-6 max-w-form-narrow">
        <div class="sm:w-1/2">
            <div class="form-group">
                <label asp-for="AppName" class="form-label" data-required></label>
                <input asp-for="AppName" class="form-control" required />
                <span asp-validation-for="AppName" class="text-btcpay-danger"></span>
            </div>
        </div>
        <div class="sm:w-1/2">
            <div class="form-group">
                <label asp-for="Title" class="form-label" data-required></label>
                <input asp-for="Title" class="form-control" required />
                <span asp-validation-for="Title" class="text-btcpay-danger"></span>
            </div>
        </div>
        <div class="form-group">
            <label asp-for="Tagline" class="form-label"></label>
            <input asp-for="Tagline" class="form-control" />
            <span asp-validation-for="Tagline" class="text-btcpay-danger"></span>
        </div>
        <div class="form-group">
            <div class="flex-between-gap-2">
                <label asp-for="MainImageFile" class="form-label"></label>
                @if (!string.IsNullOrEmpty(Model.MainImageUrl))
                {
                    <button type="submit" class="btn btn-action-danger" name="RemoveLogoFile" value="true">
                        <vc:icon symbol="cross" /> <span text-translate="true">Remove</span>
                    </button>
                }
            </div>
            @if (canUpload)
            {
                <div class="flex-row-gap-4">
                    <input asp-for="MainImageFile" type="file" class="form-control flex-grow">
                    @if (!string.IsNullOrEmpty(Model.MainImageUrl))
                    {
                        <img src="@Model.MainImageUrl" alt="Logo" style="height:2.1rem;max-width:10.5rem;" />
                    }
                </div>
                <span asp-validation-for="MainImageFile" class="text-btcpay-danger"></span>
            }
            else
            {
                <input asp-for="MainImageFile" type="file" class="form-control" disabled>
                <div class="form-text">@ViewLocalizer["In order to upload, a {0} must be configured.", Html.ActionLink(StringLocalizer["file storage"], "Files", "UIServer")]</div>
            }
        </div>
        <div class="form-group">
            <div class="flex items-center">
                <input asp-for="Enabled" type="checkbox" class="btcpay-toggle me-4"/>
                <div>
                    <label asp-for="Enabled" class="form-check-label"></label>
                    <span asp-validation-for="Enabled" class="text-btcpay-danger"></span>
                    <div class="text-btcpay-body-text-muted" text-translate="true">The crowdfund will be visible to anyone.</div>
                </div>
            </div>
        </div>
    </div>
    <div class="flex flex-wrap gap-6 mt-4">
        <div class="content-constrain-xxl">
            <div class="form-group">
                <label asp-for="Description" class="form-label" data-required></label>
                <textarea asp-for="Description" rows="20" cols="40" class="form-control richtext"></textarea>
                <span asp-validation-for="Description" class="text-btcpay-danger"></span>
            </div>
        </div>
    </div>
    <div class="flex flex-wrap gap-6">
        <div class="xl:w-5/6 content-constrain-xxl">
            <h3 class="mt-12 mb-6">Goal</h3>
            <div class="flex flex-wrap gap-4 mb-4">
                <div class="form-group w-250px mb-0">
                    <label asp-for="TargetAmount" class="form-label"></label>
                    <input inputmode="decimal" asp-for="TargetAmount" class="form-control" />
                    <span asp-validation-for="TargetAmount" class="text-btcpay-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="TargetCurrency" class="form-label"></label>
                    <input asp-for="TargetCurrency" class="form-control w-auto" currency-selection />
                    <div class="form-text">@StringLocalizer["Uses the store's default currency ({0}) if empty.", @Model.StoreDefaultCurrency]</div>
                    <span asp-validation-for="TargetCurrency" class="text-btcpay-danger"></span>
                </div>
            </div>
            <div class="flex flex-wrap gap-4 items-center mb-6">
                <div class="form-group mb-0 w-250px">
                    <label asp-for="StartDate" class="form-label"></label>
                    <div class="input-group flex-nowrap">
                        <input type="datetime-local" asp-for="StartDate"
                               value="@(Model.StartDate?.ToString("u", CultureInfo.InvariantCulture))"
                               class="form-control flatdtpicker"
                               placeholder="@StringLocalizer["No start date has been set"]" />
                        <button class="btn btn-secondary input-group-clear px-4" type="button" title="Clear">
                            <vc:icon symbol="close"/>
                        </button>
                    </div>
                </div>
                <div class="form-group mb-0 w-250px">
                    <label asp-for="EndDate" class="form-label"></label>
                    <div class="input-group flex-nowrap">
                        <input type="datetime-local" asp-for="EndDate"
                               value="@(Model.EndDate?.ToString("u", CultureInfo.InvariantCulture))"
                               class="form-control flatdtpicker"
                               placeholder="@StringLocalizer["No end date has been set"]" />
                        <button class="btn btn-secondary input-group-clear px-4" type="button" title="Clear" id="clear_end">
                            <vc:icon symbol="close"/>
                        </button>
                    </div>
                </div>
                <span asp-validation-for="StartDate" class="text-btcpay-danger"></span>
                <span asp-validation-for="EndDate" class="text-btcpay-danger"></span>
            </div>

            <div class="form-group mt-6" id="ResetRow" hidden="@(Model.StartDate == null)">
                <div class="flex items-center mb-4" x-data="{ expanded: @(Model.IsRecurring ? "true" : "false") }">
                    <input asp-for="IsRecurring" type="checkbox" class="btcpay-toggle me-4" @@click="expanded = !expanded" :aria-expanded="expanded" aria-controls="ResetEverySettings" />
                    <div>
                        <label asp-for="IsRecurring" class="form-check-label" text-translate="true">Recurring Goal</label>
                        <span asp-validation-for="IsRecurring" class="text-btcpay-danger"></span>
                        <div class="text-btcpay-body-text-muted" text-translate="true">Reset goal after a specific period of time, based on your crowdfund's start date.</div>
                    </div>
                </div>

                <div x-show="expanded" x-collapse id="ResetEverySettings">
                    <div class="form-group mb-0 pt-2 w-250px">
                        <label asp-for="ResetEveryAmount" class="form-label"></label>
                        <div class="flex items-center">
                            <input type="number" inputmode="numeric" asp-for="ResetEveryAmount" placeholder="@StringLocalizer["Amount"]" class="form-control me-4" min="0">
                            <select class="form-select w-auto" asp-for="ResetEvery">
                                @foreach (var opt in Model.ResetEveryValues)
                                {
                                    <option value="@opt">@opt</option>
                                }
                            </select>
                        </div>
                        <span asp-validation-for="ResetEveryAmount" class="text-btcpay-danger"></span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div id="perks" class="flex flex-wrap gap-6">
        <div class="content-constrain-xxl">
            <partial name="TemplateEditor" model="@(nameof(Model.PerksTemplate), Model.PerksTemplate, "Perks", Model.TargetCurrency ?? Model.StoreDefaultCurrency)" />
        </div>
    </div>
    <div class="flex flex-wrap gap-6">
        <div class="xl:w-2/3 content-constrain-xxl">
            <h3 class="mt-12 mb-6" text-translate="true">Contributions</h3>
            <div class="flex mb-4">
                <input asp-for="SortPerksByPopularity" type="checkbox" class="btcpay-toggle me-4" />
                <label asp-for="SortPerksByPopularity" class="form-check-label"></label>
                <span asp-validation-for="SortPerksByPopularity" class="text-btcpay-danger"></span>
            </div>
            <div class="flex mb-4">
                <input asp-for="DisplayPerksRanking" type="checkbox" class="btcpay-toggle me-4" />
                <label asp-for="DisplayPerksRanking" class="form-check-label"></label>
                <span asp-validation-for="DisplayPerksRanking" class="text-btcpay-danger"></span>
            </div>
            <div class="flex mb-4">
                <input asp-for="DisplayPerksValue" type="checkbox" class="btcpay-toggle me-4" />
                <label asp-for="DisplayPerksValue" class="form-check-label"></label>
                <span asp-validation-for="DisplayPerksValue" class="text-btcpay-danger"></span>
            </div>
            <div class="flex mb-4">
                <input asp-for="EnforceTargetAmount" type="checkbox" class="btcpay-toggle me-4" />
                <label asp-for="EnforceTargetAmount" class="form-check-label"></label>
                <span asp-validation-for="EnforceTargetAmount" class="text-btcpay-danger"></span>
            </div>

            <h3 class="mt-12 mb-6" text-translate="true">Crowdfund Behavior</h3>
            <div class="flex">
                <input asp-for="UseAllStoreInvoices" type="checkbox" class="btcpay-toggle me-4" />
                <label asp-for="UseAllStoreInvoices" class="form-check-label"></label>
                <span asp-validation-for="UseAllStoreInvoices" class="text-btcpay-danger"></span>
            </div>

            <h3 class="mt-12 mb-6" text-translate="true">Checkout</h3>
            <div class="form-group">
                <label asp-for="FormId" class="form-label"></label>
                <select asp-for="FormId" class="form-select w-auto" asp-items="@checkoutFormOptions"></select>
                <span asp-validation-for="FormId" class="text-btcpay-danger"></span>
            </div>

            <h3 class="mt-12 mb-2" text-translate="true">Additional Options</h3>
            <div class="form-group">
                <div class="accordion" id="additional">

                    <div class="accordion-item" x-data="{ expanded: false }">
                        <h2 class="accordion-header" id="additional-htmlheader-header">
                            <button class="accordion-button collapsed" type="button" @@click="expanded = !expanded" :aria-expanded="expanded" aria-controls="additional-htmlheader">
                                <span text-translate="true">HTML Headers</span>
                                <vc:icon symbol="caret-down" />
                            </button>
                        </h2>
                        <div id="additional-htmlheader" class="accordion-collapse" x-show="expanded" x-collapse aria-labelledby="additional-htmlheader-header">
                            <div class="accordion-body">
                                <div class="form-group">
                                    <label asp-for="Language" class="form-label"></label>
                                    <input asp-for="Language" class="form-control" maxlength="2" required />
                                    <div class="form-text">Fix the HTML page language</div>
                                    <span asp-validation-for="Language" class="text-btcpay-danger"></span>
                                </div>
                                <div class="form-group">
                                    <label asp-for="HtmlMetaTags" class="form-label"></label>
                                    <textarea asp-for="HtmlMetaTags" rows="5" cols="40" class="form-control"
                                              placeholder='<meta name="description" content="Your description">
<meta name="keywords" content="keyword1, keyword2, keyword3">
<meta name="author" content="John Doe">
Please insert valid HTML here. Only meta tags accepted.'>
                                    </textarea>
                                    <span asp-validation-for="HtmlMetaTags" class="text-btcpay-danger"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="accordion-item" x-data="{ expanded: false }">
                        <h2 class="accordion-header" id="additional-sound-header">
                            <button class="accordion-button collapsed" type="button" @@click="expanded = !expanded" :aria-expanded="expanded" aria-controls="additional-sound">
                                <span text-translate="true">Sound</span>
                                <vc:icon symbol="caret-down" />
                            </button>
                        </h2>
                        <div id="additional-sound" class="accordion-collapse" x-show="expanded" x-collapse aria-labelledby="additional-sound-header">
                            <div class="accordion-body">
                                <div class="form-group mb-0" x-data="{ expanded: @(Model.SoundsEnabled ? "true" : "false") }">
                                    <div class="flex items-center">
                                        <input asp-for="SoundsEnabled" type="checkbox" class="btcpay-toggle me-4" @@click="expanded = !expanded" :aria-expanded="expanded" aria-controls="SoundsEnabledSettings"/>
                                        <label asp-for="SoundsEnabled" class="form-check-label"></label>
                                        <span asp-validation-for="SoundsEnabled" class="text-btcpay-danger"></span>
                                    </div>
                                </div>
                                <div x-show="expanded" x-collapse id="SoundsEnabledSettings">
                                    <div class="form-group mb-0 pt-4">
                                        <label asp-for="Sounds" class="form-label"></label>
                                        <textarea asp-for="Sounds" class="form-control" rows="5"></textarea>
                                        <span asp-validation-for="Sounds" class="text-btcpay-danger"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item" x-data="{ expanded: false }">
                        <h2 class="accordion-header" id="additional-animation-header">
                            <button class="accordion-button collapsed" type="button" @@click="expanded = !expanded" :aria-expanded="expanded" aria-controls="additional-animation">
                                <span text-translate="true">Animation</span>
                                <vc:icon symbol="caret-down" />
                            </button>
                        </h2>
                        <div id="additional-animation" class="accordion-collapse" x-show="expanded" x-collapse aria-labelledby="additional-animation-header">
                            <div class="accordion-body">
                                <div class="form-group mb-0" x-data="{ expanded: @(Model.AnimationsEnabled ? "true" : "false") }">
                                    <div class="flex items-center">
                                        <input asp-for="AnimationsEnabled" type="checkbox" class="btcpay-toggle me-4" @@click="expanded = !expanded" :aria-expanded="expanded" aria-controls="AnimationsEnabledSettings"/>
                                        <label asp-for="AnimationsEnabled" class="form-check-label"></label>
                                        <span asp-validation-for="AnimationsEnabled" class="text-btcpay-danger"></span>
                                    </div>
                                </div>
                                <div x-show="expanded" x-collapse id="AnimationsEnabledSettings">
                                    <div class="form-group mb-0 pt-4">
                                        <label asp-for="AnimationColors" class="form-label"></label>
                                        <textarea asp-for="AnimationColors" class="form-control" rows="5"></textarea>
                                        <span asp-validation-for="AnimationColors" class="text-btcpay-danger"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item" x-data="{ expanded: false }">
                        <h2 class="accordion-header" id="additional-discussion-header">
                            <button class="accordion-button collapsed" type="button" @@click="expanded = !expanded" :aria-expanded="expanded" aria-controls="additional-discussion">
                                <span text-translate="true">Discussion</span>
                                <vc:icon symbol="caret-down" />
                            </button>
                        </h2>
                        <div id="additional-discussion" class="accordion-collapse" x-show="expanded" x-collapse aria-labelledby="additional-discussion-header">
                            <div class="accordion-body">
                                <div class="form-group mb-0" x-data="{ expanded: @(Model.DisqusEnabled ? "true" : "false") }">
                                    <div class="flex items-center">
                                        <input asp-for="DisqusEnabled" type="checkbox" class="btcpay-toggle me-4" @@click="expanded = !expanded" :aria-expanded="expanded" aria-controls="DisqusEnabledSettings"/>
                                        <label asp-for="DisqusEnabled" class="form-check-label"></label>
                                        <span asp-validation-for="DisqusEnabled" class="text-btcpay-danger"></span>
                                    </div>
                                </div>
                                <div x-show="expanded" x-collapse id="DisqusEnabledSettings">
                                    <div class="form-group mb-0 pt-4">
                                        <label asp-for="DisqusShortname" class="form-label"></label>
                                        <input asp-for="DisqusShortname" class="form-control" />
                                        <span asp-validation-for="DisqusShortname" class="text-btcpay-danger"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item" x-data="{ expanded: false }">
                        <h2 class="accordion-header" id="additional-notification-header">
                            <button class="accordion-button collapsed" type="button" @@click="expanded = !expanded" :aria-expanded="expanded" aria-controls="additional-notification">
                                <span text-translate="true">Notification URL Callbacks</span>
                                <vc:icon symbol="caret-down" />
                            </button>
                        </h2>
                        <div id="additional-notification" class="accordion-collapse" x-show="expanded" x-collapse aria-labelledby="additional-notification-header">
                            <div class="accordion-body">
                                <div class="form-group">
                                    <label asp-for="NotificationUrl" class="form-label"></label>
                                    <input asp-for="NotificationUrl" class="form-control" />
                                    <span asp-validation-for="NotificationUrl" class="text-btcpay-danger"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

<div class="grid sm:flex flex-wrap gap-4 mt-4">
    <form method="post" asp-controller="UIApps" asp-action="ToggleArchive" asp-route-appId="@Model.AppId" permission="@Policies.CanModifyStoreSettings">
        <button type="submit" class="w-full btn btn-outline-secondary" id="btn-archive-toggle">
            @if (Model.Archived)
            {
                <span class="whitespace-nowrap">Unarchive this app</span>
            }
            else
            {
                <span class="whitespace-nowrap" x-data x-tooltip="'Archive this app so that it does not appear in the apps list by default'" title="Archive this app so that it does not appear in the apps list by default">Archive this app</span>
            }
        </button>
    </form>
    <a id="DeleteApp" class="btn btn-outline-danger" asp-controller="UIApps" asp-action="DeleteApp" asp-route-appId="@Model.AppId" onclick="openModal('#ConfirmModal', this); return false;" data-description="The app <strong>@Html.Encode(Model.AppName)</strong> and its settings will be permanently deleted." data-confirm-input="@StringLocalizer["Delete"]" permission="@Policies.CanModifyStoreSettings">Delete this app</a>
</div>

<partial name="_Confirm" model="@(new ConfirmModel(StringLocalizer["Delete app"], StringLocalizer["This app will be removed from this store."], StringLocalizer["Delete"]))" permission="@Policies.CanModifyStoreSettings" />

