@model BTCPayServer.Models.InvoicingModels.InvoiceReceiptViewModel
@using BTCPayServer.Client
@using BTCPayServer.Client.Models
@using BTCPayServer.Services
@inject BTCPayServerEnvironment Env
@inject DisplayFormatter DisplayFormatter
@{
    Layout = null;
    ViewData["Title"] = $"Receipt from {Model.StoreName}";
    ViewData["StoreBranding"] = Model.StoreBranding;
    var isProcessing = Model.Status == InvoiceStatus.Processing;
    var isFreeInvoice = (Model.Status == InvoiceStatus.New && Model.Amount == 0);
    var isSettled = Model.Status == InvoiceStatus.Settled;
}
<!DOCTYPE html>
<html lang="en" @(Env.IsDeveloping ? " data-devenv" : "")>
<head>
    <partial name="LayoutHead"/>
    <meta name="robots" content="noindex,nofollow">
    @if (isProcessing)
    {
        <script type="text/javascript">
            setTimeout(() => { window.location.reload(); }, 10000);
        </script>
    }
	else if (isFreeInvoice)
    {
        <script type="text/javascript">
            setTimeout(() => { window.location.reload(); }, 2000);
        </script>
    }
</head>
<body class="min-h-screen">
    <div id="InvoiceReceipt" class="public-page-wrap">
        <main class="grow">
            <div class="flex flex-col justify-center gap-6">
                <partial name="_StoreHeader" model="(Model.StoreName, Model.StoreBranding)" />
                <partial name="_StatusMessage" model="@(new ViewDataDictionary(ViewData) { { "Margin", "mb-4" } })"/>
                <div id="InvoiceSummary" class="tile flex flex-wrap items-center justify-center">
                    @if (isProcessing)
                    {
                        <div class="lead text-center p-6 font-semibold" id="invoice-processing">
                            The invoice has detected a payment but is still waiting to be settled.
                        </div>
                    }
                    else if (!isSettled)
                    {
                        <div class="lead text-center p-6 font-semibold" id="invoice-unsettled">
                            The invoice is not settled.
                        </div>
                    }
                    else
                    {
                        if (Model.ReceiptOptions.ShowQR is true)
                        {
                            <vc:qr-code data="@Context.Request.GetCurrentUrl()" />
                        }
                        <div class="flex gap-6 mb-0 flex-1">
                            <dl class="flex flex-col gap-6 mb-0 flex-1">
                                <div class="flex flex-col">
                                    <dd class="text-btcpay-body-text-muted mb-0 font-semibold">Amount Paid</dd>
                                    <dt class="fs-2 mb-0 whitespace-nowrap font-semibold">@DisplayFormatter.Currency(Model.Amount, Model.Currency, DisplayFormatter.CurrencyFormat.Symbol)</dt>
                                </div>
                                @if (Model.TaxIncluded != 0.0m)
                                {
                                    <div class="flex flex-col">
                                        <dd class="text-btcpay-body-text-muted mb-0 font-semibold">Total Taxes</dd>
                                        <dt class="fs-5 mb-0 whitespace-nowrap font-semibold">@DisplayFormatter.Currency(Model.TaxIncluded, Model.Currency, DisplayFormatter.CurrencyFormat.Symbol)</dt>
                                    </div>
                                }
                                <div class="flex flex-col">
                                    <dd class="text-btcpay-body-text-muted mb-0 font-semibold">Date</dd>
                                    <dt class="fs-5 mb-0 whitespace-nowrap font-semibold">@Model.Timestamp.ToBrowserDate()</dt>
                                </div>
                                @if (!string.IsNullOrEmpty(Model.OrderId))
                                {
                                    <div class="flex flex-col">
                                        <dd class="text-btcpay-body-text-muted mb-0 font-semibold">Order ID</dd>
                                        <dt class="fs-5 mb-0 text-break font-semibold">@Model.OrderId</dt>
                                    </div>
                                }
                            </dl>
                            <a href="?print=true" class="grow-0 self-start btn btn-secondary print:hidden fs-4" target="_blank" id="ReceiptLinkPrint">Print</a>
                        </div>
                    }
                </div>

                @if (isProcessing)
                {
                    <small class="block text-btcpay-body-text-muted text-center px-6">This page will refresh periodically until the invoice is settled.</small>
                }
                else if (isSettled)
                {
                    if (Model.AdditionalData?.Any() is true)
                    {
                        <div id="AdditionalData" class="tile">
                            <h2 class="h4 mb-4">Additional Data</h2>
                            <div class="overflow-x-auto my-0">
                                <partial name="PosData" model="(Model.AdditionalData, 1)"/>
                            </div>
                        </div>
                    }
                    if (Model.CartData?.Any() is true)
                    {
                        <div id="CartData" class="tile">
                            <h2 class="h4 mb-4">Cart</h2>
                            <div class="overflow-x-auto my-0">
                                <partial name="PosData" model="(Model.CartData, 1)" />
                            </div>
                        </div>
                    }
                    if (Model.Payments?.Any() is true)
                    {
                        <div id="PaymentDetails" class="tile">
                            <h2 class="h4 mb-4">Payment Details</h2>
                            <div class="overflow-x-auto my-0 print:hidden">
                                <table class="invoice table table-borderless">
                                    <thead>
										<tr>
											<th class="font-normal text-btcpay-body-text-muted">Destination</th>
											<th class="font-normal text-btcpay-body-text-muted">Payment</th>
											<th class="font-normal text-btcpay-body-text-muted">Rate</th>
											<th class="font-normal text-btcpay-body-text-muted">Payment Method</th>
											<th class="font-normal text-btcpay-body-text-muted whitespace-nowrap">Date</th>
										</tr>
                                    </thead>
                                    @foreach (var payment in Model.Payments)
                                    {
                                        <tbody>
											<tr>
												<td>
													@if (!string.IsNullOrEmpty(payment.Destination))
													{
														<vc:truncate-center text="@payment.Destination" link="@payment.Link" classes="truncate-center-id" />
													}
												</td>
												<td>
													<span class="block font-semibold whitespace-nowrap">@payment.AmountFormatted</span>
													<small class="text-btcpay-body-text-muted whitespace-nowrap">@payment.PaidFormatted</small>
												</td>
												<td class="whitespace-nowrap">@payment.RateFormatted</td>
												<td class="whitespace-nowrap">@payment.PaymentMethod</td>
												<td class="whitespace-nowrap">@payment.ReceivedDate.ToBrowserDate()</td>
											</tr>

											@if (!string.IsNullOrEmpty(payment.PaymentProof))
											{
												<tr>
													<th class="font-normal whitespace-nowrap text-btcpay-body-text-muted">
														Payment Proof
													</th>
													<td class="font-normal" colspan="4">
														<vc:truncate-center text="@payment.PaymentProof" link="@payment.Link" classes="truncate-center-id" />
													</td>
												</tr>
											}
                                        </tbody>
                                    }
                                </table>
                            </div>
                            <div class="hidden print:block">
                                @foreach (var payment in Model.Payments)
                                {
                                    <div class="mb-6">
                                        <strong>@payment.PaidFormatted</strong> = @payment.Amount @payment.PaymentMethod, Rate: @payment.RateFormatted
                                        @if (!string.IsNullOrEmpty(payment.PaymentProof))
                                        {
                                            <div>Proof: @payment.PaymentProof</div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
                @if (!string.IsNullOrEmpty(Model.RedirectUrl))
                {
                    <a href="@Model.RedirectUrl" class="btn btn-secondary rounded-full mx-auto mt-4" rel="noreferrer noopener" target="_blank" id="StoreLink">Return to @(string.IsNullOrEmpty(Model.StoreName) ? "store" : Model.StoreName)</a>
                }
            </div>
        </main>
        <footer class="store-footer">
            <p permission="@Policies.CanViewInvoices" class="print:hidden">
                <a asp-action="Invoice" asp-route-invoiceId="@Model.InvoiceId">
                    Admin details
                </a>
            </p>
            <a class="store-powered-by" href="https://btcpayserver.org" target="_blank" rel="noreferrer noopener">
                <span text-translate="true">Powered by</span> <partial name="_StoreFooterLogo" />
            </a>
        </footer>
    </div>
    <partial name="LayoutFoot"/>
</body>
</html>

