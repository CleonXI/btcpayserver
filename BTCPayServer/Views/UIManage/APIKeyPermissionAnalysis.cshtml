@using BTCPayServer.Client
@model BTCPayServer.Controllers.UIManageController.ApiKeyPermissionAnalyticsViewModel
@{
    var staleThresholdDays = 100;
    var usedPermissionsPercentage = Model.TotalPermissions > 0 ? (int)Math.Round((double)Model.UsedPermissions.Count / Model.TotalPermissions * 100) : 0;
	ViewData.SetLayoutModel(new LayoutModel(nameof(ManageNavPages.APIKeys), StringLocalizer["API Key Analysis"])
		.SetCategory(nameof(ManageNavPages)));
}

<div class="sticky-header">
    <nav aria-label="breadcrumb">
        <ol class="flex flex-wrap mb-[var(--btcpay-space-m)] list-none">
            <li class="breadcrumb-chevron">
                <a asp-action="APIKeys" text-translate="true">API Keys</a>
            </li>
            <li class="breadcrumb-chevron" aria-current="page">@ViewData["Title"]</li>
        </ol>
        <h2>@ViewData["Title"]</h2>
    </nav>
</div>

<div class="flex flex-wrap gap-4 mb-6">
    <div class="md:w-1/3">
        <div class="relative flex flex-col min-w-0 break-words bg-[var(--btcpay-bg-tile)] rounded-lg h-full border-0 shadow-sm">
            <div class="flex-1 p-4">
                <div class="flex items-center justify-between mb-2">
                    <span class="text-btcpay-body-text-muted small" text-translate="true">Total Permissions</span>
                    <i class="bi bi-key fs-5 text-btcpay-body-text-muted"></i>
                </div>
                <div class="display-6 font-bold mb-2">@Model.TotalPermissions</div>
                <div class="flex h-[4px] overflow-hidden bg-[var(--btcpay-secondary-bg)] rounded-[var(--btcpay-border-radius)]">
                    <div class="bg-[var(--btcpay-primary)] transition-[width] duration-[0.6s] ease-[ease]" style="width:100%"></div>
                </div>
            </div>
        </div>
    </div>
    <div class="md:w-1/3">
        <div class="relative flex flex-col min-w-0 break-words bg-[var(--btcpay-bg-tile)] rounded-lg h-full border-0 shadow-sm">
            <div class="flex-1 p-4">
                <div class="flex items-center justify-between mb-2">
                    <span class="text-btcpay-body-text-muted small" text-translate="true">Used Permissions</span>
                    <i class="bi bi-check-circle fs-5 text-btcpay-body-text-muted"></i>
                </div>
                <div class="display-6 font-bold mb-1">@Model.UsedPermissions.Count</div>
                <div class="small text-btcpay-body-text-muted mb-2">@usedPermissionsPercentage% of total</div>
                <div class="flex h-[4px] overflow-hidden bg-[var(--btcpay-secondary-bg)] rounded-[var(--btcpay-border-radius)]">
                    <div class="bg-[var(--btcpay-primary)] transition-[width] duration-[0.6s] ease-[ease]" style="width:@usedPermissionsPercentage%"></div>
                </div>
            </div>
        </div>
    </div>
    <div class="md:w-1/3">
        <div class="relative flex flex-col min-w-0 break-words bg-[var(--btcpay-bg-tile)] rounded-lg h-full border-0 shadow-sm">
            <div class="flex-1 p-4">
                <div class="flex items-center justify-between mb-2">
                    <span class="text-btcpay-body-text-muted small" text-translate="true">Unused Permissions</span>
                    <i class="bi bi-exclamation-circle fs-5 text-btcpay-body-text-muted"></i>
                </div>
                <div class="display-6 font-bold mb-1">@Model.UnusedPermissions.Count</div>
                <div class="small text-btcpay-body-text-muted mb-2">@(100 - usedPermissionsPercentage)% of total</div>
                <div class="flex h-[4px] overflow-hidden bg-[var(--btcpay-secondary-bg)] rounded-[var(--btcpay-border-radius)]">
                    <div class="bg-[var(--btcpay-primary)] transition-[width] duration-[0.6s] ease-[ease]" style="width:@(100 - usedPermissionsPercentage)%"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="relative flex flex-col min-w-0 break-words bg-[var(--btcpay-bg-tile)] rounded-lg border-0 shadow-sm overflow-hidden">
    <div class="px-4 py-2 bg-white border-b border-[var(--btcpay-body-border-medium)]">
        <ul class="nav nav-underline" id="permissionTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="all-tab" @@click="tab = 'all-permissions'" :class="tab === 'all-permissions' && 'active'" type="button" role="tab">
                    @ViewLocalizer["All ({0})", Model.AllPermissions.Count]
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="used-tab" @@click="tab = 'used-permissions'" :class="tab === 'used-permissions' && 'active'" type="button" role="tab">
                    @ViewLocalizer["Used ({0})", Model.UsedPermissions.Count]
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="unused-tab" @@click="tab = 'unused-permissions'" :class="tab === 'unused-permissions' && 'active'" type="button" role="tab">
                    @ViewLocalizer["Unused ({0})", Model.UnusedPermissions.Count]
                </button>
            </li>
        </ul>
    </div>
    <div class="flex-1 p-3">
        <div class="tab-content" id="permissionTabContent">

            <div x-show="tab === 'all-permissions'" id="all-permissions" role="tabpanel">
                @if (Model.AllPermissions.Any())
                {
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th text-translate="true">Permission</th>
                                <th text-translate="true">Usage Count</th>
                                <th text-translate="true">Last Used</th>
                                <th text-translate="true">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var permission in Model.AllPermissions.OrderBy(p => p.Permission))
                            {
                                var usage = Model.UsedPermissions.FirstOrDefault(u => u.Permission == permission.Permission);
                                var isUsed = usage != null;
                                var isStale = isUsed && (DateTimeOffset.UtcNow - usage.LastUsed).TotalDays > staleThresholdDays;
                                <tr>
                                    <td><code>@permission.Permission</code></td>
                                    <td>
                                        @if (isUsed)
                                        {
                                            <span class="font-semibold">@usage.UsageCount.ToString("N0")</span>
                                        }
                                        else
                                        {
                                            <span class="text-btcpay-body-text-muted">—</span>
                                        }
                                    </td>
                                    <td>
                                        @if (isUsed)
                                        {
                                            <span class="text-btcpay-body-text-muted">@usage.LastUsed.ToTimeAgo()</span>
                                        }
                                        else
                                        {
                                            <span class="text-btcpay-body-text-muted" text-translate="true">Never</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!isUsed)
                                        {
                                            <span class="badge bg-btcpay-secondary" text-translate="true">Never Used</span>
                                        }
                                        else if (isStale)
                                        {
                                            <span class="badge bg-btcpay-warning text-btcpay-dark" text-translate="true">Stale</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-btcpay-success" text-translate="true">Active</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="text-center py-12 text-btcpay-body-text-muted">
                        <i class="bi bi-inbox fs-1 block mb-2"></i>
                        <span text-translate="true">No Permission Usage Recorded</span>
                    </div>
                }
            </div>

            <div x-show="tab === 'used-permissions'" id="used-permissions" role="tabpanel">
                @if (Model.UsedPermissions.Any())
                {
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th text-translate="true">Permission</th>
                                <th text-translate="true">Usage Count</th>
                                <th text-translate="true">Last Used</th>
                                <th text-translate="true">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var permission in Model.UsedPermissions.OrderByDescending(p => p.LastUsed))
                            {
                                var isStale = (DateTimeOffset.UtcNow - permission.LastUsed).TotalDays > staleThresholdDays;
                                <tr>
                                    <td><code>@permission.Permission</code></td>
                                    <td><span class="font-semibold">@permission.UsageCount.ToString("N0")</span></td>
                                    <td><span class="text-btcpay-body-text-muted">@permission.LastUsed.ToTimeAgo()</span></td>
                                    <td>
                                        @if (isStale)
                                        {
                                            <span class="badge bg-btcpay-warning text-btcpay-dark" text-translate="true">Stale</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-btcpay-success" text-translate="true">Active</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="text-center py-12 text-btcpay-body-text-muted">
                        <i class="bi bi-inbox fs-1 block mb-2"></i>
                        <span text-translate="true">No Permission Usage Recorded</span>
                    </div>
                }
            </div>

            <div x-show="tab === 'unused-permissions'" id="unused-permissions" role="tabpanel">
                @if (Model.UnusedPermissions.Any())
                {
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th text-translate="true">Permission</th>
                                <th text-translate="true">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var permission in Model.UnusedPermissions.OrderBy(p => p))
                            {
                                <tr>
                                    <td><code>@permission</code></td>
                                    <td><span class="badge bg-btcpay-secondary" text-translate="true">Never Used</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="text-center py-12">
                        <i class="bi bi-shield-check text-btcpay-success fs-1 block mb-2"></i>
                        @if (Model.TotalPermissions > 0)
                        {
                            <span class="font-semibold" text-translate="true">All permissions are in use!</span>
                        }
                        else
                        {
                            <span class="text-btcpay-body-text-muted" text-translate="true">No Permission Usage Recorded</span>
                        }
                    </div>
                }
            </div>

        </div>
    </div>
</div>
