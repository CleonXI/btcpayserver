{
  "private": true,
  "type": "module",
  "description": "BTCPay Server frontend linting",
  "scripts": {
    "lint:js": "eslint wwwroot --ignore-pattern vendor/",
    "lint:css": "stylelint \"wwwroot/**/*.css\" --ignore-pattern \"vendor/**\"",
    "lint": "npm run lint:js && npm run lint:css"
  },
  "devDependencies": {
    "eslint": "^9.24.0",
    "@eslint/js": "^9.24.0",
    "globals": "^16.0.0",
    "stylelint": "^16.17.0",
    "stylelint-config-standard": "^37.0.0"
  }
}
